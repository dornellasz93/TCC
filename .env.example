# ==============================================================================
# UGB PRESENÇA — Variáveis de Ambiente (Servidor Doméstico / Docker)
# Copie este arquivo para ".env" antes de subir em produção:
#   cp .env.example .env
# ==============================================================================

# Porta exposta no servidor doméstico
PORT=5000

# Chave secreta para assinatura dos tokens JWT (troque em produção!)
JWT_SECRET=ugb-tcc-2026-gere-uma-chave-segura-aqui
JWT_EXPIRES_IN=12h

# Caminho do banco SQLite (no Docker, mantém no volume /app/data)
DB_PATH=/app/data/presenca_tcc.sqlite

# Limiar padrão de similaridade facial (0.50 a 0.95 — padrão 0.72 = 72%)
BIOMETRIC_THRESHOLD=0.72

# Duração padrão de cada janela de chamada (1ª e 2ª presença) em minutos
CALL_DURATION_MINUTES=20

# Opcional: Token do Cloudflare Tunnel para HTTPS público no servidor doméstico
# Crie grátis em: https://one.dash.cloudflare.com -> Networks -> Tunnels
# Aponte o Public Hostname para: http://ugb-presenca:5000
CLOUDFLARE_TUNNEL_TOKEN=
