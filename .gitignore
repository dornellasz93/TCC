# ==============================================================================
# Node.js / npm / Expo / Vite / SQLite — .gitignore otimizado
# ==============================================================================

# Todos os módulos Node (nunca sobem para o Git; instalados via npm ci / Docker)
node_modules/
**/node_modules/
.npm/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e segredos locais
.env
.env.local
.env.*.local
!.env.example

# Bancos SQLite e arquivos temporários WAL/SHM (persistidos em volume Docker)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
server/data/

# Builds, caches e artefatos gerados
dist/
build/
**/dist/
**/build/
.vite/
**/.vite/
.cache/
**/.cache/
coverage/
*.tsbuildinfo

# Expo / React Native (caches e builds nativos locais)
.expo/
**/.expo/
.expo-shared/
web-build/
**/web-build/
mobile/android/
mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.hbc

# Logs, editores e arquivos de sistema
*.log
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
